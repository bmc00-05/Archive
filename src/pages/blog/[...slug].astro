---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { Badge } from "@/components/ui/badge";
import { mdxComponents } from "@/lib/mdx-components";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
---

<BlogLayout title={`${data.title} — Archive`} description={data.description}>
  {/* 글 헤더: 제목 → 작성날짜·태그 → 요약 → 구분선 */}
  <header class="mb-10 border-b pb-8">
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight leading-tight">
      {data.title}
    </h1>

    <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted-foreground">
      <time>{data.pubDate.toISOString().slice(0, 10)}</time>
      {data.tags.length > 0 && (
        <>
          <span aria-hidden class="text-border">·</span>
          <div class="flex flex-wrap gap-1.5">
            {data.tags.map((t) => (
              <Badge variant="outline" className="font-normal text-xs">{t}</Badge>
            ))}
          </div>
        </>
      )}
    </div>

    {data.description && (
      <p class="mt-5 text-lg leading-relaxed text-muted-foreground">
        {data.description}
      </p>
    )}
  </header>

  <article class="prose prose-neutral dark:prose-invert max-w-none">
    <Content components={mdxComponents} />
  </article>
</BlogLayout>
