---
import { type CollectionEntry, getCollection, render } from "astro:content";
import BlogLayout from "@/layouts/BlogLayout.astro";
import { Badge } from "@/components/ui/badge";
import { ArrowLeft } from "lucide-react";
import { mdxComponents } from "@/lib/mdx-components";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"blog">;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BlogLayout title={`${data.title} — Archive`} description={data.description}>
  <a
    href={base + "/"}
    class="inline-flex items-center gap-1 text-sm text-muted-foreground hover:text-foreground transition-colors mb-6"
  >
    <ArrowLeft className="size-4" /> Blog
  </a>

  <header class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight">{data.title}</h1>
    <p class="mt-2 text-muted-foreground">{data.description}</p>
    <div class="mt-3 flex items-center gap-3 text-xs text-muted-foreground">
      <time>{data.pubDate.toISOString().slice(0, 10)}</time>
      {data.tags.length > 0 && (
        <div class="flex flex-wrap gap-1.5">
          {data.tags.map((t) => (
            <Badge variant="outline" className="font-normal text-xs">{t}</Badge>
          ))}
        </div>
      )}
    </div>
  </header>

  <article class="prose prose-neutral dark:prose-invert max-w-none">
    <Content components={mdxComponents} />
  </article>
</BlogLayout>
