---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Badge } from "@/components/ui/badge";
import { siteConfig } from "@/lib/site.config";
import { Github, Mail } from "lucide-react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const education = [
  {
    period: "2025.07 - 2026.06",
    title: "SSAFY 14기",
    place: "삼성청년SW아카데미",
    detail: "풀스택 SW 엔지니어 양성 과정",
  },
];

const skills = {
  Frontend: ["TypeScript", "React", "Astro", "Vite", "TailwindCSS", "MDX"],
  Backend: ["Spring Boot", "Node.js", "MySQL", "Redis", "REST"],
  Tools: ["Git", "Docker", "GitHub Actions", "Jira", "Figma"],
};
---

<BaseLayout title="About — Archive" description="bmc00-05의 이력과 스킬.">
  <main class="mx-auto max-w-3xl px-6 py-12 md:py-16">
    <header class="mb-12">
      <p class="text-xs uppercase tracking-wider text-muted-foreground">About</p>
      <h1 class="mt-2 text-4xl font-bold tracking-tight">{siteConfig.author.name}</h1>
      <p class="mt-4 text-lg text-muted-foreground leading-relaxed">
        문제를 풀기 위해 코드를 쓰는 사람. 사용자 경험의 디테일에 집착하고, 만든 것의 마무리를 중요하게 생각합니다.
      </p>
      <div class="mt-6 flex items-center gap-3">
        <a
          href={siteConfig.author.github}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <Github className="size-4" /> {siteConfig.author.github.replace("https://", "")}
        </a>
        <a
          href={`mailto:${siteConfig.author.email}`}
          class="inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-foreground transition-colors"
        >
          <Mail className="size-4" /> {siteConfig.author.email}
        </a>
      </div>
    </header>

    <div class="h-px bg-border my-8"></div>

    <section class="py-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-6">
        Education
      </h2>
      <ul class="space-y-5">
        {
          education.map((item) => (
            <li class="grid grid-cols-[140px_1fr] gap-4">
              <p class="text-xs text-muted-foreground pt-0.5">{item.period}</p>
              <div>
                <p class="font-medium">{item.title}</p>
                <p class="text-sm text-muted-foreground mt-0.5">{item.place}</p>
                {item.detail && (
                  <p class="text-sm text-muted-foreground mt-1">{item.detail}</p>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <div class="h-px bg-border my-8"></div>

    <section class="py-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-6">
        Skills
      </h2>
      <div class="space-y-5">
        {
          Object.entries(skills).map(([category, items]) => (
            <div class="grid grid-cols-[120px_1fr] gap-4 items-start">
              <p class="text-sm font-medium">{category}</p>
              <div class="flex flex-wrap gap-1.5">
                {items.map((item) => (
                  <Badge variant="secondary" className="font-normal">
                    {item}
                  </Badge>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>

    <div class="h-px bg-border my-8"></div>

    <section class="py-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">
        Projects
      </h2>
      <p class="text-sm text-muted-foreground">
        상세한 프로젝트 사례는 <a href={base + "/portfolio"} class="underline underline-offset-4 hover:text-foreground">Portfolio</a> 페이지에서 확인할 수 있습니다.
      </p>
    </section>
  </main>
</BaseLayout>
