---
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import DocViewer from "@/components/organisms/DocViewer";
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import TechStackSection from "@/components/organisms/TechStackSection";
import { Button } from "@/components/ui/button";
import { getPublishedProjects } from "@/lib/content";
import { siteConfig } from "@/lib/site.config";
import { Github, Mail } from "lucide-react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const projects = await getPublishedProjects();
const articleId = "portfolio-home";
---

<PortfolioLayout
  title="Portfolio — bmc00-05"
  description="만든 것들을 모아둔 공간."
  wide
>
  <article
    id={articleId}
    class="prose prose-neutral dark:prose-invert max-w-none"
  >
    {/* 1. Intro */}
    <section
      data-slide
      data-slug="intro"
      data-layout="hero"
      class="slide-canvas"
    >
      <p class="text-xs uppercase tracking-[0.2em] text-muted-foreground">
        Portfolio
      </p>
      <h1 class="mt-3 text-4xl md:text-6xl font-bold tracking-[-0.01em] leading-[1.2] max-w-4xl">
        안녕하세요,<br />즐겁게 일하는 개발자<br /><span class="text-emerald-500 dark:text-emerald-400">추보문</span> 입니다.
      </h1>
      <p class="mt-5 text-lg md:text-xl text-muted-foreground max-w-2xl">
        문제를 풀기 위해 코드를 쓰는 사람입니다. 풀스택을 지향하지만 프론트엔드에 무게중심을 두고 있으며, 만든 것의 디테일과 마무리를 가장 중요하게 생각합니다.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <Button asChild>
          <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
            <Github className="size-4" />
            GitHub
          </a>
        </Button>
        <Button variant="outline" asChild>
          <a href={`mailto:${siteConfig.author.email}`}>
            <Mail className="size-4" />
            Email
          </a>
        </Button>
      </div>
    </section>

    {/* 2. Tech Stack */}
    <section
      data-slide
      data-slug="stack"
      class="slide-canvas"
    >
      <TechStackSection client:visible />
    </section>

    {/* 3. Featured Projects */}
    <section
      data-slide
      data-slug="projects"
      class="slide-canvas"
    >
      <div class="flex items-baseline justify-between">
        <h2 class="text-lg md:text-xl font-bold tracking-tight">
          Featured Projects
        </h2>
        <span class="text-xs text-muted-foreground">{projects.length}개</span>
      </div>

      <div class="grid md:grid-cols-2 gap-3 not-prose">
        {
          projects.map((p) => (
            <ProjectCard
              href={`${base}/portfolio/${p.id}`}
              title={p.data.title}
              summary={p.data.summary}
              cover={p.data.cover}
              period={p.data.period}
              role={p.data.role}
              stack={p.data.stack}
            />
          ))
        }
      </div>
    </section>

    {/* 4. About */}
    <section
      data-slide
      data-slug="about"
      class="slide-canvas"
    >
      <h2 class="text-lg md:text-xl font-bold tracking-tight">
        About
      </h2>

      <div class="mt-6 space-y-4 text-base md:text-lg leading-relaxed max-w-2xl">
        <p>
          SSAFY (Samsung SW Academy For Youth) 14기 수료 예정. 풀스택 개발을 학습 중이며, 특히 프론트엔드의 사용자 경험 디테일에 관심이 많습니다.
        </p>
        <p class="text-muted-foreground">
          문제를 단순화하고, 만든 것의 끝까지 책임지는 개발자가 되고 싶습니다.
        </p>
      </div>

      <div class="mt-8">
        <Button variant="outline" asChild>
          <a href={base + "/about"}>
            자세한 이력 보기 →
          </a>
        </Button>
      </div>
    </section>

    {/* 5. Contact */}
    <section
      data-slide
      data-slug="contact"
      data-layout="center"
      class="slide-canvas"
    >
      <h2 class="text-lg md:text-xl font-bold tracking-tight">
        Contact
      </h2>
      <p class="mt-4 text-muted-foreground max-w-md">
        함께 만들어보고 싶은 게 있거나, 그냥 인사하고 싶으시면 언제든 메일을 보내주세요.
      </p>

      <div class="mt-10 flex flex-col items-center gap-4">
        <a
          href={`mailto:${siteConfig.author.email}`}
          class="text-xl md:text-2xl font-medium hover:underline underline-offset-4"
        >
          {siteConfig.author.email}
        </a>
        <div class="flex items-center gap-3">
          <Button variant="outline" size="sm" asChild>
            <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
              <Github className="size-4" />
              GitHub
            </a>
          </Button>
          <Button variant="outline" size="sm" asChild>
            <a href={`mailto:${siteConfig.author.email}`}>
              <Mail className="size-4" />
              Email
            </a>
          </Button>
        </div>
      </div>
    </section>
  </article>

  <DocViewer client:load articleId={articleId} />
</PortfolioLayout>
