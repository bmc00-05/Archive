---
import PortfolioLayout from "@/layouts/PortfolioLayout.astro";
import { ProjectCard } from "@/components/molecules/ProjectCard";
import { Button } from "@/components/ui/button";
import { Badge } from "@/components/ui/badge";
import { getPublishedProjects } from "@/lib/content";
import { siteConfig } from "@/lib/site.config";
import { Github, Mail } from "lucide-react";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const projects = await getPublishedProjects();

const skills = {
  Frontend: ["TypeScript", "React", "Astro", "Vite", "TailwindCSS"],
  Backend: ["Spring Boot", "Node.js", "MySQL", "Redis"],
  Tools: ["Git", "Docker", "GitHub Actions", "Jira"],
};
---

<PortfolioLayout
  title="Portfolio — bmc00-05"
  description="만든 것들을 모아둔 공간."
>
  {/* Hero */}
  <section class="py-12 md:py-20">
    <p class="text-sm text-muted-foreground tracking-wider uppercase mb-3">
      Portfolio
    </p>
    <h1 class="text-4xl md:text-5xl font-bold tracking-tight">
      안녕하세요,<br />{siteConfig.author.name} 입니다.
    </h1>
    <p class="mt-6 text-lg text-muted-foreground max-w-2xl leading-relaxed">
      문제를 풀기 위해 코드를 쓰는 사람입니다. 풀스택을 지향하지만 프론트엔드에 무게중심을 두고 있으며, 만든 것의 디테일과 마무리를 가장 중요하게 생각합니다.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button asChild>
        <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer">
          <Github className="size-4" />
          GitHub
        </a>
      </Button>
      <Button variant="outline" asChild>
        <a href={`mailto:${siteConfig.author.email}`}>
          <Mail className="size-4" />
          Email
        </a>
      </Button>
      <Button variant="ghost" asChild>
        <a href={base + "/about"}>About →</a>
      </Button>
    </div>
  </section>

  <div class="h-px bg-border my-6"></div>

  {/* Tech Stack */}
  <section class="py-10">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-6">
      Tech Stack
    </h2>
    <div class="space-y-5">
      {
        Object.entries(skills).map(([category, items]) => (
          <div class="grid grid-cols-[120px_1fr] gap-4 items-start">
            <p class="text-sm font-medium">{category}</p>
            <div class="flex flex-wrap gap-1.5">
              {items.map((item) => (
                <Badge variant="secondary" className="font-normal">
                  {item}
                </Badge>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="h-px bg-border my-6"></div>

  {/* Featured Projects */}
  <section class="py-10">
    <div class="flex items-baseline justify-between mb-6">
      <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        Featured Projects
      </h2>
      <span class="text-xs text-muted-foreground">{projects.length}개</span>
    </div>
    <div class="grid md:grid-cols-2 gap-4">
      {
        projects.map((p) => (
          <ProjectCard
            href={`${base}/portfolio/${p.id}`}
            title={p.data.title}
            summary={p.data.summary}
            period={p.data.period}
            role={p.data.role}
            stack={p.data.stack}
          />
        ))
      }
    </div>
  </section>

  <div class="h-px bg-border my-6"></div>

  {/* About Summary */}
  <section class="py-10">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">
      About
    </h2>
    <div class="space-y-3 text-base leading-relaxed">
      <p>
        SSAFY (Samsung SW Academy For Youth) 14기 수료 예정. 풀스택 개발을 학습 중이며, 특히 프론트엔드의 사용자 경험 디테일에 관심이 많습니다.
      </p>
      <p class="text-muted-foreground">
        자세한 이력과 경력은 <a href={base + "/about"} class="underline underline-offset-4 hover:text-foreground">About 페이지</a>에서 확인할 수 있습니다.
      </p>
    </div>
  </section>

  <div class="h-px bg-border my-6"></div>

  {/* Contact */}
  <section class="py-10">
    <h2 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-4">
      Contact
    </h2>
    <div class="space-y-2 text-base">
      <p>
        <a href={`mailto:${siteConfig.author.email}`} class="underline underline-offset-4 hover:text-muted-foreground">
          {siteConfig.author.email}
        </a>
      </p>
      <p>
        <a href={siteConfig.author.github} target="_blank" rel="noopener noreferrer" class="underline underline-offset-4 hover:text-muted-foreground">
          {siteConfig.author.github.replace("https://", "")}
        </a>
      </p>
    </div>
  </section>
</PortfolioLayout>
