---
import BlogLayout from "@/layouts/BlogLayout.astro";
import { getPublishedPosts } from "@/lib/content";

const posts = await getPublishedPosts();
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<BlogLayout title="Archive — Blog" description="기록과 만든 것들.">
  <header class="mb-10">
    <p class="text-xs uppercase tracking-wider text-muted-foreground">Blog</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight">기록</h1>
    <p class="mt-2 text-muted-foreground">
      배운 것, 만든 것, 풀었던 문제들을 정리합니다.
    </p>
  </header>

  {
    posts.length === 0 ? (
      <div class="border rounded-lg p-10 text-center">
        <p class="text-sm text-muted-foreground">아직 발행된 글이 없습니다.</p>
        <p class="mt-2 text-xs text-muted-foreground">
          첫 글은 곧 작성될 예정입니다.
          그동안 <a href={base + "/portfolio"} class="underline underline-offset-4 hover:text-foreground">Portfolio</a>를 둘러보세요.
        </p>
      </div>
    ) : (
      <ul class="space-y-6">
        {posts.map((post) => (
          <li>
            <a href={`${base}/blog/${post.id}`} class="group block">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="text-lg font-semibold tracking-tight group-hover:underline underline-offset-4">
                  {post.data.title}
                </h2>
                <time class="text-xs text-muted-foreground shrink-0">
                  {post.data.pubDate.toISOString().slice(0, 10)}
                </time>
              </div>
              <p class="mt-1 text-sm text-muted-foreground line-clamp-2">
                {post.data.description}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</BlogLayout>
