---
import { getThumbnail, type BlogEntry } from "@/lib/content";
import PostListInteractive from "./PostListInteractive";

interface Props {
  /** 목록 상단 제목 (현재 카테고리명: 최신글, 알고리즘, 자료구조 ...) */
  title: string;
  posts: BlogEntry[];
}
const { title, posts } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// React 아일랜드로 넘길 직렬화 데이터 (썸네일은 서버에서 추출)
const items = posts.map((p) => ({
  id: p.id,
  title: p.data.title,
  description: p.data.description ?? "",
  date: p.data.pubDate.toISOString().slice(0, 10),
  thumb: getThumbnail(p) ?? null,
  tags: p.data.tags ?? [],
}));
---

<header class="mb-8">
  <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
</header>

<PostListInteractive client:load base={base} posts={items} pageSize={5} />
