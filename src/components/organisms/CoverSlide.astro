---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Button } from "@/components/ui/button";
import { StackIcon } from "@/components/atoms/StackIcon";
import { Github, ExternalLink, FileText } from "lucide-react";

interface Props {
  data: {
    title: string;
    summary: string;
    period: string;
    role: string;
    stack: readonly string[];
    cover?: ImageMetadata;
    teamSize?: number;
    repo?: string;
    demo?: string;
    deck?: string;
  };
}

const { data } = Astro.props;
---

<section
  data-slide
  data-slug="cover"
  data-layout="default"
  class="slide-canvas"
>
  <div class="not-prose w-full flex flex-col gap-4 md:gap-5">
    {/* Cover Image — 폭 축소 (max-w-2xl) */}
    {data.cover ? (
      <div class="rounded-xl bg-card overflow-hidden max-w-2xl mx-auto w-full">
        <Image
          src={data.cover}
          alt={data.title}
          widths={[400, 600, 800, 900]}
          sizes="(max-width: 768px) 100vw, 640px"
          class="w-full aspect-video object-cover"
        />
      </div>
    ) : (
      <div class="rounded-xl bg-muted/30 aspect-video flex items-center justify-center max-w-2xl mx-auto w-full">
        <span class="text-2xl font-semibold text-muted-foreground/40">
          {data.title}
        </span>
      </div>
    )}

    {/* Meta — 텍스트 only, 볼드 강조, 3열 한눈에 */}
    <div class="grid grid-cols-3 gap-4 md:gap-10 max-w-2xl mx-auto w-full text-center">
      <div>
        <p class="text-[10px] uppercase tracking-[0.15em] text-muted-foreground">기간</p>
        <p class="mt-1.5 font-bold text-base md:text-lg tracking-tight">
          {data.period}
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.15em] text-muted-foreground">역할</p>
        <p class="mt-1.5 font-bold text-base md:text-lg tracking-tight">
          {data.role}
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.15em] text-muted-foreground">팀</p>
        <p class="mt-1.5 font-bold text-base md:text-lg tracking-tight">
          {data.teamSize ? `${data.teamSize}인` : "—"}
        </p>
      </div>
    </div>

    {/* Tech Stack — 정사각형 아이콘 그리드 */}
    <div class="max-w-3xl mx-auto w-full">
      <p class="text-[11px] uppercase tracking-wider text-muted-foreground mb-2 text-center">
        Stack
      </p>
      <div class="flex flex-wrap justify-center gap-2.5 md:gap-3">
        {data.stack.map((s) => (
          <div
            class="size-14 md:size-16 rounded-xl bg-card border border-border/40 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all flex items-center justify-center"
            title={s}
          >
            <StackIcon name={s} className="size-12 md:size-14" />
          </div>
        ))}
      </div>
    </div>

    {/* Quick Links */}
    {(data.repo || data.demo || data.deck) && (
      <div class="flex flex-wrap justify-center gap-2 pt-1">
        {data.repo && (
          <Button variant="outline" size="sm" asChild>
            <a href={data.repo} target="_blank" rel="noopener noreferrer">
              <Github className="size-4" /> Repository
            </a>
          </Button>
        )}
        {data.demo && (
          <Button variant="outline" size="sm" asChild>
            <a href={data.demo} target="_blank" rel="noopener noreferrer">
              <ExternalLink className="size-4" /> Live Demo
            </a>
          </Button>
        )}
        {data.deck && (
          <Button variant="outline" size="sm" asChild>
            <a href={data.deck} target="_blank" rel="noopener noreferrer">
              <FileText className="size-4" /> 발표 자료
            </a>
          </Button>
        )}
      </div>
    )}
  </div>
</section>
