---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Badge } from "@/components/ui/badge";

interface Props {
  href: string;
  title: string;
  summary: string;
  cover?: ImageMetadata;
  period: string;
  role: string;
  stack: readonly string[];
}

const { href, title, summary, cover, period, role, stack } = Astro.props;
---

<a
  href={href}
  class="group block relative aspect-[16/10] rounded-lg border bg-card overflow-hidden transition-shadow hover:shadow-md not-prose"
  aria-label={`${title} — ${summary}`}
>
  {/* 기본: 커버 이미지 */}
  {cover ? (
    <Image
      src={cover}
      alt=""
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      widths={[400, 600, 800, 1000]}
      sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 480px"
    />
  ) : (
    <div class="absolute inset-0 flex items-center justify-center bg-muted/40">
      <span class="text-2xl font-semibold text-muted-foreground/40">
        {title}
      </span>
    </div>
  )}

  {/* 호버 오버레이: 제목 + 한 줄 설명 + 메타 */}
  <div
    class="absolute inset-0 flex flex-col justify-center p-5 md:p-6 bg-background/95 backdrop-blur-sm opacity-0 transition-opacity duration-200 group-hover:opacity-100"
  >
    <h3 class="font-bold text-lg md:text-xl tracking-tight">{title}</h3>
    <p class="mt-2 text-sm text-muted-foreground line-clamp-3">{summary}</p>

    <div class="mt-3 flex items-center gap-2 text-[11px] text-muted-foreground">
      <span>{period}</span>
      <span aria-hidden>·</span>
      <span>{role}</span>
    </div>

    <div class="mt-3 flex flex-wrap gap-1">
      {stack.slice(0, 5).map((s) => (
        <Badge variant="outline" className="font-normal text-[10px] px-1.5 py-0">
          {s}
        </Badge>
      ))}
      {stack.length > 5 && (
        <Badge variant="outline" className="font-normal text-[10px] px-1.5 py-0">
          +{stack.length - 5}
        </Badge>
      )}
    </div>
  </div>
</a>
