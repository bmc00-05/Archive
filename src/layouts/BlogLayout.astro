---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Sidebar from "@/components/organisms/Sidebar.astro";
import MobileSidebar from "@/components/organisms/MobileSidebar";
import { getPublishedPosts, getPublishedProjects } from "@/lib/content";
import { siteConfig } from "@/lib/site.config";

interface Props {
  title?: string;
  description?: string;
}
const { title, description } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const projects = (await getPublishedProjects()).map((p) => ({
  title: p.data.title,
  href: `${base}/portfolio/${p.id}`,
}));
const recentPosts = (await getPublishedPosts()).slice(0, 5).map((p) => ({
  title: p.data.title,
  href: `${base}/blog/${p.id}`,
}));
---

<BaseLayout title={title} description={description} hideChrome>
  <div class="md:hidden border-b sticky top-0 z-40 bg-background/80 backdrop-blur">
    <div class="flex items-center justify-between px-4 h-12">
      <MobileSidebar
        client:load
        base={base}
        siteName={siteConfig.name}
        recentPosts={recentPosts}
        projects={projects}
        author={{ github: siteConfig.author.github, email: siteConfig.author.email }}
      />
      <a href={base + "/"} class="font-semibold text-sm tracking-tight">{siteConfig.name}</a>
      <div class="w-9"></div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-6 md:px-8 py-8 md:py-12 grid md:grid-cols-[240px_1fr] gap-8 md:gap-12">
    <div class="hidden md:block">
      <div class="sticky top-8">
        <Sidebar />
      </div>
    </div>
    <main class="min-w-0">
      <slot />
    </main>
  </div>
</BaseLayout>
