---
import BaseLayout from "@/layouts/BaseLayout.astro";

interface Props {
  title?: string;
  description?: string;
  /** true 이면 max-w 제약 없이 전체 폭 사용 (프로젝트 상세 페이지용) */
  wide?: boolean;
}
const { title, description, wide = false } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <main class={wide ? "w-full" : "mx-auto max-w-4xl px-6 py-12 md:py-16"}>
    <slot />
  </main>
</BaseLayout>
